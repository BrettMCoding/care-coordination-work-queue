# Server runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Browser origins allowed to call the API, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,https://carequeue.brettmarshmakesthings.com

# MongoDB Atlas configuration. Use a real URI only in local .env files or Secret Manager.
MONGODB_DB_NAME=carequeue
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/carequeue?retryWrites=true&w=majority
